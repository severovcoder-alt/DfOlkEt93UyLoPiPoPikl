# Локальный запуск: скопируй в .env и заполни своими значениями.
# На Railway .env НЕ нужен — переменные задаются в Variables панели проекта.
FIREBASE_SERVICE_ACCOUNT=

# Тот же секрет, что static-auth-secret в /etc/turnserver.conf на VPS с coturn.
TURN_SHARED_SECRET=
# Домен coturn-сервера (A-запись на VPS).
TURN_HOST=turn.linqosocial.online

# Загрузка медиа (фото/видео/голосовые/файлы) — хранится на диске
# сервера вместо Cloudinary. На Railway/Render без persistent volume
# диск эфемерный (сотрётся при редеплое) — если сервер крутится не на
# твоём VPS напрямую, примонтируй volume в MEDIA_DIR.
MEDIA_DIR=./media_storage
# Через сколько дней НЕактивности (никто не скачивал и не загружал)
# файл удаляется автоочисткой.
MEDIA_TTL_DAYS=60
# Необязательный общий лимит на весь размер хранилища в ГБ — новые
# загрузки будут отклоняться с 507, пока место не освободится
# (автоочисткой или ручным DELETE /media/:id). Оставь пустым — без лимита.
MEDIA_MAX_TOTAL_GB=
