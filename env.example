# Локальный запуск: скопируй в .env и заполни своими значениями.
# На Railway .env НЕ нужен — переменные задаются в Variables панели проекта.
FIREBASE_SERVICE_ACCOUNT=

# Тот же секрет, что static-auth-secret в /etc/turnserver.conf на VPS с coturn.
TURN_SHARED_SECRET=
# Домен coturn-сервера (A-запись на VPS).
TURN_HOST=turn.linqosocial.online
